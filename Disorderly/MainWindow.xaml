<Window x:Class="Disorderly.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Disorderly" Width="1060" Height="780" MinWidth="760" MinHeight="560">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="DISORDERLY · Configuration" FontSize="24" FontWeight="Bold"/>
            <TextBlock x:Name="StateLabel" Margin="0,8" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusLabel" TextWrapping="Wrap" Margin="0,8"/>
            <TextBlock x:Name="IssueCount" FontWeight="Bold"/>
            <ListBox x:Name="Issues" Height="110" AutomationProperties.Name="Configuration validation diagnostics"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="InspectButton" Content="Inspect Published" Margin="4" Padding="12,6" Click="OnInspect"/>
                <Button x:Name="DiscardButton" Content="Discard Changes / Refresh" Margin="4" Padding="12,6" Click="OnDiscard"/>
                <Button x:Name="SaveButton" Content="Save" Margin="4" Padding="24,6" Click="OnSave" AutomationProperties.Name="Save configuration"/>
            </StackPanel>
        </StackPanel>
        <TabControl x:Name="Sections" AutomationProperties.Name="Configuration sections">
            <TabItem Header="Commands">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <DockPanel x:Name="CommandSidebar" Margin="0,0,12,0">
                        <StackPanel x:Name="NewCommandPanel" DockPanel.Dock="Bottom"/>
                        <ListBox x:Name="CommandList" AutomationProperties.Name="Command definitions" SelectionChanged="OnCommandSelected"/>
                    </DockPanel>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="CommandDetails"/></ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Contexts">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <DockPanel x:Name="ContextSidebar" Margin="0,0,12,0">
                        <StackPanel x:Name="NewContextPanel" DockPanel.Dock="Bottom"/>
                        <ListBox x:Name="ContextList" AutomationProperties.Name="Context definitions" SelectionChanged="OnContextSelected"/>
                    </DockPanel>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ContextDetails"/></ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>