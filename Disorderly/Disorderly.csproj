<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <VersionPrefix>0.1.0</VersionPrefix>
        <VersionSuffix>alpha</VersionSuffix>
        <IncludePackageReferencesDuringMarkupCompilation>true</IncludePackageReferencesDuringMarkupCompilation>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Resources\Images\Disorderly.ico</ApplicationIcon>
        <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup>
      <None Remove="Resources\Images\Disorderly.ico" />
      <None Remove="Resources\Images\Disorderly.png" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.161" />
        <PackageReference Include="ReactiveMarbles.ObservableEvents.SourceGenerator" Version="1.3.1" />
        <PackageReference Include="ReactiveUI" Version="26.0.1" />
        <PackageReference Include="ReactiveUI.Primitives.ObservableEvents" Version="9.0.0" PrivateAssets="all" />
        <PackageReference Include="Dirkster.AvalonDock" Version="5.0.1" />
        <PackageReference Include="Dirkster.AvalonDock.Serializer.Xml" Version="5.0.1" />
        <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="5.0.1" />
        <PackageReference Include="Extended.Wpf.Toolkit" Version="5.1.2" />
        <PackageReference Include="FluentValidation" Version="12.2.0" />
        <PackageReference Include="ReactiveUI.Testing" Version="26.0.1" />
        <PackageReference Include="ReactiveUI.Validation" Version="8.1.0" />
        <PackageReference Include="Microsoft-WindowsAPICodePack-Shell" Version="1.1.5" />
        <PackageReference Include="Nito.AsyncEx" Version="5.1.2" />
        <PackageReference Include="Nito.AsyncEx.Tasks" Version="5.1.2" />
        <PackageReference Include="ReactiveUI.WPF" Version="26.0.1" />
        <PackageReference Include="StringMath" Version="4.1.3" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
        <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
        <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="TrayIcon" Version="1.3.0" />
    </ItemGroup>
    <ItemGroup>
        <Folder Include="Resources\UI\" />
    </ItemGroup>
    <ItemGroup>
      <Resource Include="Resources\Images\Disorderly.ico" />
      <Resource Include="Resources\Images\Disorderly.png" />
    </ItemGroup>
</Project>