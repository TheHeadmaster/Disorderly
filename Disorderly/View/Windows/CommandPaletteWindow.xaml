<Window x:Class="Disorderly.View.Windows.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Disorderly Command Palette" Width="360" SizeToContent="Manual"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Topmost="True" Background="#171B24"
        Foreground="#F3F4F8" Icon="/Disorderly;component/Resources/Images/Disorderly.ico">
    <Border x:Name="FocusSurface" BorderBrush="#778BCA" BorderThickness="1" Padding="18"
            Focusable="True" KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="Context shortcuts">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Image Source="/Disorderly;component/Resources/Images/Disorderly.png" Width="24" Height="24" Margin="0,0,10,0" />
                    <TextBlock Text="DISORDERLY" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="ContextTitle" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"
                           AutomationProperties.Name="Active context" />
                <TextBlock x:Name="Breadcrumb" Foreground="#B8C6E6" TextWrapping="Wrap" Margin="0,4,0,10" />
            </StackPanel>
            <ScrollViewer x:Name="ContextScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Press a shortcut..." Foreground="#C4CCE0" Margin="0,0,0,8" />
                    <TextBlock x:Name="EmptyContext" Text="No shortcuts configured in this context." TextWrapping="Wrap" Foreground="#B8C6E6" />
                    <ItemsControl x:Name="BindingList" Focusable="False" AutomationProperties.Name="Available context shortcuts">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,0,0,5" Background="#252C3B" AutomationProperties.Name="{Binding AccessibleName}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Gesture}" Foreground="#B9CBFF" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Kind}" Foreground="#B8C6E6" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border x:Name="SelectionPreview" Visibility="Collapsed" BorderBrush="#778BCA" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0">
                        <StackPanel AutomationProperties.Name="Selected command preview">
                            <TextBlock x:Name="SelectionTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="SelectionDescription" TextWrapping="Wrap" Margin="0,4,0,4" Foreground="#C4CCE0" />
                            <TextBlock x:Name="SelectionStatus" TextWrapping="Wrap" Foreground="#B9CBFF"
                                       AutomationProperties.Name="Command execution status" AutomationProperties.LiveSetting="Polite" />
                            <Button x:Name="RunButton" Content="Run" Visibility="Collapsed" IsEnabled="False"
                                    HorizontalAlignment="Left" Margin="0,10,0,0" Padding="18,6" Click="OnRunClick"
                                    PreviewMouseLeftButtonDown="OnRunMouseDown" PreviewMouseLeftButtonUp="OnRunMouseUp"
                                    AutomationProperties.Name="Run selected command" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <TextBlock x:Name="NavigationHint" Grid.Row="2" Foreground="#B8C6E6" FontSize="12" />
        </Grid>
    </Border>
</Window>