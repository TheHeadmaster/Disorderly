<Window x:Class="Disorderly.View.Windows.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Disorderly Command Palette" Width="360" SizeToContent="Manual"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Topmost="True" Background="#171B24"
        Foreground="#F3F4F8" Icon="/Disorderly;component/Resources/Images/Disorderly.ico">
    <Border BorderBrush="#454E65" BorderThickness="1" Padding="18">
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <Image Source="/Disorderly;component/Resources/Images/Disorderly.png" Width="24" Height="24" Margin="0,0,10,0" />
                <TextBlock Text="DISORDERLY" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="Root" Foreground="#AEB9DA" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
            <TextBox x:Name="CommandInput" AutomationProperties.Name="Root command input"
                     FontSize="18" Padding="10" Background="#252C3B" Foreground="#F3F4F8"
                     BorderBrush="#778BCA" CaretBrush="White" IsReadOnly="True" />
            <TextBlock Text="Press a shortcut..." Margin="0,10,0,0" Foreground="#C4CCE0" />
            <Border Margin="0,16,0,0" Padding="0,12,0,0" BorderBrush="#343D50" BorderThickness="0,1,0,0">
                <TextBlock Text="Command suggestions will appear here in a future update."
                           TextWrapping="Wrap" Foreground="#919CB7" FontSize="12" />
            </Border>
            <TextBlock Text="Esc to dismiss" Margin="0,14,0,0" Foreground="#919CB7" FontSize="11" />
        </StackPanel>
    </Border>
</Window>
